{
  "appId": "ci.maeva.immobilier",
  "productName": "MAEVA IMMOBILIER",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "electron/**/*", "backend/src/**/*", "backend/package.json", "backend/.env", "assets/**/*", "package.json"],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "MAEVA IMMOBILIER"
  }
}
