# Configuration du serveur MAEVA IMMOBILIER (/etc/maeva/maeva.env, droits 600, propriétaire root)
# Générée automatiquement par installer-serveur.sh — ne jamais commiter le vrai fichier.
NODE_ENV=production
HOST=127.0.0.1
PORT=4001
SERVIR_FRONTEND=1
TRUST_PROXY=loopback
CORS_ORIGINES=https://maeva-immobilier.com,https://www.maeva-immobilier.com

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=maeva
DB_PASSWORD=<mot de passe aléatoire>
DB_NAME=maeva_immobilier

JWT_SECRET=<64 octets aléatoires en hexadécimal>
# Jeton d'accès court (les clients renouvellent via le refresh token)
JWT_ACCES_MINUTES=60
REFRESH_JOURS=30

MAEVA_DOSSIER_SAUVEGARDES=/var/lib/maeva/sauvegardes
