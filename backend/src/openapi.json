{
  "openapi": "3.0.3",
  "info": {
    "title": "MAEVA IMMOBILIER — API",
    "version": "1.0.0",
    "description": "API de gestion locative et devis BTP. Contrat de référence pour les clients web, Electron et Android (Kotlin/Retrofit).\n\nAuth : `Authorization: Bearer <token>` (jeton d'accès court) + `refresh_token` pour le renouvellement.\n\nErreurs : `{ \"message\": \"...\", \"code\": \"...\" }` — `message` lisible en français, `code` stable pour le programme.\n\nMois : chaîne `AAAA-MM`. Montants : entiers en FCFA (pas de centimes)."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Erreur": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "ex : MDP_A_CHANGER"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton d'accès JWT, durée courte (JWT_ACCES_MINUTES)"
          },
          "refresh_token": {
            "type": "string",
            "description": "Jeton longue durée, à conserver côté client (DataStore)"
          },
          "refresh_expire_le": {
            "type": "string",
            "format": "date-time"
          },
          "utilisateur": {
            "$ref": "#/components/schemas/Utilisateur"
          }
        }
      },
      "Utilisateur": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "nom_complet": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "gerant",
              "comptable",
              "lecteur"
            ]
          },
          "doit_changer_mdp": {
            "type": "boolean"
          }
        }
      },
      "Versement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "locataire_id": {
            "type": "integer"
          },
          "mois": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "montant": {
            "type": "integer",
            "description": "FCFA"
          },
          "date_versement": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "loyer",
              "avance",
              "caution"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "Espèces",
              "Mobile Money",
              "Virement",
              "Chèque"
            ]
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "numero_quittance": {
            "type": "string",
            "example": "Q-2026-000123"
          },
          "existant": {
            "type": "boolean",
            "description": "true si renvoyé via la même cle_idempotence"
          }
        }
      },
      "Locataire": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "batiment_id": {
            "type": "integer"
          },
          "numero_porte": {
            "type": "string",
            "nullable": true
          },
          "nom_locataire": {
            "type": "string"
          },
          "loyer_mensuel": {
            "type": "integer"
          },
          "statut": {
            "type": "string",
            "enum": [
              "Actif",
              "Parti",
              "Vide"
            ]
          },
          "debut_suivi": {
            "type": "string",
            "nullable": true
          },
          "mois_sortie": {
            "type": "string",
            "nullable": true
          },
          "caution": {
            "type": "integer"
          },
          "solde_initial": {
            "type": "integer"
          }
        }
      },
      "Situation": {
        "type": "object",
        "properties": {
          "du": {
            "type": "integer"
          },
          "verse": {
            "type": "integer"
          },
          "solde": {
            "type": "integer"
          },
          "dette": {
            "type": "integer"
          },
          "dette_mois": {
            "type": "number"
          },
          "avance": {
            "type": "integer"
          },
          "paye_jusqu_a": {
            "type": "string",
            "nullable": true
          },
          "recu_mois": {
            "type": "integer"
          },
          "loyer": {
            "type": "integer"
          }
        }
      },
      "EntreeAudit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "action": {
            "type": "string"
          },
          "entite": {
            "type": "string"
          },
          "entite_id": {
            "type": "integer"
          },
          "details": {
            "type": "object"
          },
          "ip": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "username": {
            "type": "string"
          },
          "nom_complet": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "NonAutorise": {
        "description": "Session absente/expirée",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erreur"
            }
          }
        }
      },
      "Interdit": {
        "description": "Rôle insuffisant ou mot de passe à changer",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erreur"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Connexion — paire accès + refresh",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ouverte",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants incorrects"
          },
          "429": {
            "description": "Trop de tentatives (blocage 15 min)"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Renouvelle la session (rotation : l'ancien refresh est révoqué)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh_token"
                ],
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nouvelle paire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Session expirée, révoquée ou inconnue — reconnectez l'utilisateur"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Révoque la session de l'appareil",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Révoqué"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Compte courant",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Utilisateur"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "summary": "Changement de mot de passe (révoque les autres sessions, renvoie une nouvelle paire)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ancien",
                  "nouveau"
                ],
                "properties": {
                  "ancien": {
                    "type": "string"
                  },
                  "nouveau": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nouvelle session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Règle de mot de passe violée"
          }
        }
      }
    },
    "/locataires": {
      "get": {
        "summary": "Liste des locataires",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "batiment_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Locataires",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Locataire"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Créer (entrée avec caution/avance)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Créé"
          },
          "403": {
            "$ref": "#/components/responses/Interdit"
          }
        }
      }
    },
    "/locataires/{id}": {
      "get": {
        "summary": "Fiche complète : situation, versements, loyers, notes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "mois",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fiche"
          },
          "404": {
            "description": "Introuvable"
          }
        }
      },
      "put": {
        "summary": "Modifier (loyer_a_partir_de pour une révision datée)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Modifié"
          }
        }
      },
      "delete": {
        "summary": "Supprimer",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Supprimé"
          }
        }
      }
    },
    "/locataires/{id}/depart": {
      "post": {
        "summary": "Départ : dette déduite de la caution, remboursement optionnel en dépense",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mois_sortie"
                ],
                "properties": {
                  "mois_sortie": {
                    "type": "string"
                  },
                  "retenue": {
                    "type": "integer"
                  },
                  "remboursement": {
                    "type": "integer"
                  },
                  "depense_remboursement": {
                    "type": "boolean"
                  },
                  "porte_vide": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Départ enregistré"
          }
        }
      }
    },
    "/versements": {
      "get": {
        "summary": "Liste des versements",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "mois",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locataire_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Versement"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Encaisser — idempotent via cle_idempotence",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "locataire_id",
                  "mois",
                  "montant"
                ],
                "properties": {
                  "locataire_id": {
                    "type": "integer"
                  },
                  "mois": {
                    "type": "string"
                  },
                  "montant": {
                    "type": "integer"
                  },
                  "date_versement": {
                    "type": "string",
                    "format": "date"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "Espèces",
                      "Mobile Money",
                      "Virement",
                      "Chèque"
                    ]
                  },
                  "note": {
                    "type": "string"
                  },
                  "cle_idempotence": {
                    "type": "string",
                    "description": "UUID généré par le client à chaque saisie"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Déjà enregistré (même clé d'idempotence)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Versement"
                }
              }
            }
          },
          "201": {
            "description": "Créé + quittance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Versement"
                }
              }
            }
          }
        }
      }
    },
    "/versements/{id}/quittance": {
      "get": {
        "summary": "Quittance PDF du versement",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "application/pdf",
            "content": {
              "application/pdf": {}
            }
          },
          "404": {
            "description": "Introuvable"
          }
        }
      }
    },
    "/versements/{id}": {
      "delete": {
        "summary": "Supprimer un versement",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Supprimé"
          }
        }
      }
    },
    "/audit": {
      "get": {
        "summary": "Journal d'audit (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "entite",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entite_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "depuis",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 200,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entrées récentes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntreeAudit"
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Interdit"
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "summary": "Agrégat du mois (bâtiments, locataires, dépenses, résumé)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "mois",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contexte du mois"
          }
        }
      }
    },
    "/batiments": {
      "get": {
        "summary": "Bâtiments",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste"
          }
        }
      },
      "post": {
        "summary": "Créer",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Créé"
          }
        }
      }
    },
    "/depenses": {
      "get": {
        "summary": "Dépenses du mois",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste"
          }
        }
      },
      "post": {
        "summary": "Enregistrer une dépense",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Créée"
          }
        }
      }
    },
    "/resumes": {
      "get": {
        "summary": "Résumés mensuels (historique)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste"
          }
        }
      }
    },
    "/devis": {
      "get": {
        "summary": "Devis BTP",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste"
          }
        }
      },
      "post": {
        "summary": "Créer un devis",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Créé"
          }
        }
      }
    },
    "/catalogue": {
      "get": {
        "summary": "Catalogue d'articles BTP",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste"
          }
        }
      }
    },
    "/sauvegardes": {
      "get": {
        "summary": "Sauvegardes disponibles (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste"
          }
        }
      },
      "post": {
        "summary": "Sauvegarde manuelle",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Créée"
          }
        }
      }
    },
    "/unites": {
      "get": {
        "summary": "Portes physiques avec occupation courante",
        "tags": [
          "unites"
        ],
        "parameters": [
          {
            "name": "batiment_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "statut",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "occupee",
                "libre"
              ]
            }
          }
        ]
      },
      "post": {
        "summary": "Declarer une porte (admin, gerant)",
        "tags": [
          "unites"
        ]
      }
    },
    "/unites/{id}": {
      "get": {
        "summary": "Porte + historique de ses occupations",
        "tags": [
          "unites"
        ]
      },
      "put": {
        "summary": "Modifier porte / loyer de base (admin, gerant)",
        "tags": [
          "unites"
        ]
      },
      "delete": {
        "summary": "Supprimer une porte jamais occupee (admin)",
        "tags": [
          "unites"
        ]
      }
    },
    "/contrats": {
      "get": {
        "summary": "Contrats d'occupation (alias de /locataires)",
        "tags": [
          "contrats"
        ]
      },
      "post": {
        "summary": "Creer un contrat — unite_id pour occuper une porte existante",
        "tags": [
          "contrats"
        ]
      }
    },
    "/contrats/{id}": {
      "get": {
        "summary": "Fiche contrat : compte, versements, quittances",
        "tags": [
          "contrats"
        ]
      },
      "put": {
        "summary": "Modifier un contrat (loyer_a_partir_de pour revision datee)",
        "tags": [
          "contrats"
        ]
      },
      "delete": {
        "summary": "Supprimer un contrat sans ecriture cloturee",
        "tags": [
          "contrats"
        ]
      }
    },
    "/contrats/{id}/depart": {
      "post": {
        "summary": "Departure : retenue sur caution + remboursement + porte vide",
        "tags": [
          "contrats"
        ]
      }
    },
    "/relances": {
      "get": {
        "summary": "Locataires en dette + liens WhatsApp/SMS pre-remplis",
